{
  "name": "morrow-local-chat",
  "version": "0.3.0",
  "description": "A private desktop chat for local language models",
  "author": "Morrow",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.5",
      "@electron/universal": {
        "minimatch": "^11.0.5"
      }
    }
  },
  "build": {
    "appId": "app.morrow.localchat",
    "productName": "Morrow",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LOCAL_MODEL.md",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/morrow-logo.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Morrow",
      "menuCategory": "Morrow",
      "runAfterFinish": true
    }
  }
}
